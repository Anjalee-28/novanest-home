{
    "$schema": "https://vercel.sh",
    "services": {
        "backend": {
            "root": "backend",
            "framework": "fastapi"
        },
        "frontend": {
            "root": "frontend",
            "framework": "nextjs"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend",
                "path": "/$1"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}